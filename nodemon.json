{
  "restartable": "rs",
  "watch": ["src", ".env"],
  "ext": "js,json",
  "ignore": ["src/**/*.test.js", "src/**/*.spec.js", "dist", "node_modules"],
  "exec": "node --disable-warning=DEP0040 --env-file=.env src/server.js",
  "delay": 500,
  "signal": "SIGTERM",
  "verbose": false,
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "clear"
  }
}
